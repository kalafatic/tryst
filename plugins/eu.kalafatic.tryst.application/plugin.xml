<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         id="application"
         point="org.eclipse.core.runtime.applications">
      <application
            cardinality="singleton-global"
            thread="main"
            visible="true">
         <run
               class="eu.kalafatic.tryst.application.TrystApplication">
         </run>
      </application>
   </extension>
   <extension
         id="server"
         point="org.eclipse.core.runtime.applications">
      <application
            cardinality="singleton-global"
            thread="main"
            visible="true">
         <run
               class="eu.kalafatic.tryst.application.TrystServerApplication">
         </run>
      </application>
   </extension>
   <extension
         id="product"
         point="org.eclipse.core.runtime.products">
      <product
            application="eu.kalafatic.tryst.application.application"
            name="TRYST – AI Development Environment">
         <property
               name="appName"
               value="TRYST – AI Development Environment">
         </property>
         <property
               name="aboutImage"
               value="about.png">
         </property>
         <property
               name="aboutText"
               value="Version: {0}&#x0A;Build id: {1}&#x0A;&#x0A;(c) Copyright 2026 eu.kalafatic&#x0A;All rights reserved.&#x0A;&#x0A;TRYST is an AI-assisted software development platform providing a Jules-like workflow: tasks, sessions, repositories, sandboxes and configurable coding agents with full diff review and approval.&#x0A;&#x0A;Java runtime: {2}&#x0A;Eclipse platform: {3}">
         </property>
         <property
               name="windowImages"
               value="tryst16.png,tryst32.png,tryst48.png,tryst64.png">
         </property>
         <property
               name="startupForegroundColor"
               value="94A3B8">
         </property>
         <property
               name="startupProgressRect"
               value="40,240,420,15">
         </property>
         <property
               name="startupMessageRect"
               value="40,220,420,20">
         </property>
      </product>
   </extension>
   <extension
         point="org.eclipse.ui.splashHandlers">
      <splashHandler
            id="eu.kalafatic.tryst.application.splashHandler"
            class="eu.kalafatic.tryst.application.splash.TrystSplashHandler">
      </splashHandler>
      <splashHandlerProductBinding
            splashId="eu.kalafatic.tryst.application.splashHandler"
            productId="eu.kalafatic.tryst.application.product">
      </splashHandlerProductBinding>
   </extension>
</plugin>
