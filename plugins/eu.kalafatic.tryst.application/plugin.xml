<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         id="application"
         point="org.eclipse.core.runtime.applications">
      <application
            cardinality="singleton-global"
            thread="main"
            visible="true">
         <run
               class="eu.kalafatic.tryst.application.TrystApplication">
         </run>
      </application>
   </extension>
   <extension
         id="product"
         point="org.eclipse.core.runtime.products">
      <product
            application="eu.kalafatic.tryst.application.application"
            name="TRYST – AI Development Environment">
         <property
               name="appName"
               value="TRYST – AI Development Environment">
         </property>
      </product>
   </extension>
</plugin>
